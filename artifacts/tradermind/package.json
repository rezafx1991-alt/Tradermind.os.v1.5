{
  "name": "@workspace/tradermind",
  "version": "1.6.1",
  "description": "ژورنال معاملاتی آفلاین TraderMind OS",
  "author": "TraderMind <support@tradermind.app>",
  "repository": {
    "type": "git",
    "url": "https://github.com/rezafx1991-alt/Tradermind.os.v1.5.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "electron:build:vite": "vite build --config vite.electron.config.ts",
    "electron:compile": "tsc --project tsconfig.electron.json && node -e \"require('fs').writeFileSync('electron/dist/package.json', JSON.stringify({type:'commonjs'}))\"",
    "electron:build:win": "pnpm run electron:build:vite && pnpm run electron:compile && electron-builder --win --config electron-builder.json --publish never",
    "electron:build:mac": "pnpm run electron:build:vite && pnpm run electron:compile && electron-builder --mac --config electron-builder.json",
    "android:build:vite": "vite build --config vite.capacitor.config.ts",
    "android:sync": "pnpm run android:build:vite && cap sync android",
    "android:open": "cap open android"
  },
